{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroharness.dev/schemas/v1/action-envelope.schema.json",
  "title": "Neuroharness Action Envelope",
  "description": "Canonical description of one proposed agent action. `proposal` is agent-authored and untrusted; `context` is harness-authored. The envelope digest is SHA-256 over the RFC 8785 (JCS) canonical form of this whole object. Requirements: FR-02, FR-03, FR-04, FR-10, FR-12.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "action_id", "proposal", "context"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "action_id": {
      "description": "Harness-stamped UUIDv7; shared across repair iterations of the same action.",
      "type": "string",
      "format": "uuid"
    },
    "proposal": { "$ref": "#/$defs/Proposal" },
    "context": { "$ref": "#/$defs/Context" }
  },
  "$defs": {
    "Proposal": {
      "description": "Agent-authored. Nothing here is a policy input except `tool`, `intent` and typed `arguments` after schema validation. `claims` are recorded and never evaluated (INV-08).",
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "intent", "arguments"],
      "properties": {
        "tool": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$", "maxLength": 128 },
        "intent": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
        "arguments": {
          "description": "Validated separately against the tool's argument schema from the registry; unknown keys are rejected there (FR-02).",
          "type": "object"
        },
        "claims": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/Claim" }
        }
      }
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
        "value": { "type": ["string", "number", "boolean", "null"], "maxLength": 512 }
      }
    },
    "Context": {
      "description": "Harness-authored. Any context-shaped keys found in the proposal are stripped and the stripping is recorded (FR-03).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id", "session_id", "trace_id", "proposed_at", "repair_iteration",
        "actor", "action_class", "facts", "policy_bundle", "critic_versions"
      ],
      "properties": {
        "tenant_id": { "type": "string", "maxLength": 64 },
        "session_id": { "type": "string", "maxLength": 128 },
        "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "proposed_at": { "type": "string", "format": "date-time" },
        "repair_iteration": { "type": "integer", "minimum": 0, "maximum": 10 },
        "actor": { "$ref": "#/$defs/Actor" },
        "action_class": { "$ref": "#/$defs/ActionClassRef" },
        "facts": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/Fact" }
        },
        "policy_bundle": { "$ref": "#/$defs/VersionedArtifact" },
        "critic_versions": {
          "type": "object",
          "additionalProperties": { "type": "string", "maxLength": 64 }
        },
        "stripped_proposal_keys": {
          "description": "Context-shaped keys removed from the proposal by the envelope builder.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "Actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "agent_version", "principal", "delegation_chain", "environment"],
      "properties": {
        "agent_id": { "type": "string", "maxLength": 128 },
        "agent_version": { "type": "string", "maxLength": 64 },
        "principal": {
          "description": "Pseudonymous identifier of the human principal on whose behalf the agent acts, resolved by the identity layer (never from the proposal).",
          "type": "string",
          "maxLength": 128
        },
        "delegation_chain": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "pattern": "^(user|service|workflow|agent):[A-Za-z0-9._-]+$" }
        },
        "environment": { "type": "string", "enum": ["development", "test", "staging", "production"] },
        "model_identity": {
          "description": "Governed model identity used for monitor certification matching (FR-54).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model_id": { "type": "string", "maxLength": 128 },
            "model_version": { "type": "string", "maxLength": 64 },
            "prompt_family_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      }
    },
    "ActionClassRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_version", "registry_digest", "registered", "mode"],
      "properties": {
        "registry_version": { "type": "string", "maxLength": 64 },
        "registry_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "registered": { "type": "boolean" },
        "mode": { "type": "string", "enum": ["shadow", "advisory", "enforce"] },
        "repair_budget": { "type": "integer", "minimum": 0, "maximum": 10 },
        "approvable": { "type": "boolean" },
        "abstain_escalates_to_approval": { "type": "boolean" }
      }
    },
    "Fact": {
      "description": "Obtained by the harness from a registered provider (FR-10). The only kind of statement policy may read.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key", "value", "source", "provider_version", "fetched_at", "ttl_seconds", "digest"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64 },
        "key": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
        "value": {},
        "source": { "type": "string", "maxLength": 128 },
        "provider_version": { "type": "string", "maxLength": 64 },
        "fetched_at": { "type": "string", "format": "date-time" },
        "ttl_seconds": { "type": "integer", "minimum": 0 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "VersionedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "version": { "type": "string", "maxLength": 64 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}

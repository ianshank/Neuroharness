{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroharness.dev/schemas/v1/action-envelope.schema.json",
  "title": "Neuroharness Action Envelope",
  "description": "Canonical description of one proposed agent action. `proposal` is agent-authored and untrusted; `context` is harness-authored. The PROPOSAL digest (proposal + context.actor + context.action_class + context.policy_bundle, JCS-canonical, SHA-256) is what approvals bind to; the ENVELOPE digest (this whole object) is what decision tokens bind to. Requirements: FR-02, FR-03, FR-04, FR-06, FR-07, FR-10, FR-12, FR-14, FR-34.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "action_id",
    "proposal",
    "context"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "action_id": {
      "description": "Harness-stamped UUIDv7; shared across repair iterations of the same action; the idempotency key (FR-27).",
      "type": "string",
      "format": "uuid"
    },
    "proposal": {
      "$ref": "#/$defs/Proposal"
    },
    "context": {
      "$ref": "#/$defs/Context"
    }
  },
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Principal": {
      "type": "string",
      "pattern": "^(user|service|workflow|agent|system):[A-Za-z0-9._-]{1,96}$"
    },
    "Proposal": {
      "description": "Agent-authored. Only `tool`, `intent` and typed `arguments` (validated against the action class's argument_schema) reach the policy input, and they select WHICH rules apply; they never satisfy an authorization or evidence rule (INV-01). `claims` are recorded and never evaluated (INV-08, FR-12).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "intent",
        "arguments"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
          "maxLength": 128
        },
        "intent": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 64
        },
        "arguments": {
          "description": "Validated separately against the action class's `argument_schema` (additionalProperties:false; enumerations for every policy-compared argument, drawn from the resource-key registry). Unknown keys are SCHEMA_INVALID (FR-02).",
          "type": "object"
        },
        "claims": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/Claim"
          }
        },
        "batch_dependencies": {
          "description": "Indices within the same batch this call depends on (FR-07).",
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "Claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 64
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Context": {
      "description": "Harness-authored. Context-shaped keys found in the raw payload are stripped before validation and listed in `stripped_proposal_keys` (FR-03).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "session_id",
        "session_root_id",
        "trace_id",
        "proposed_at",
        "repair_iteration",
        "actor",
        "action_class",
        "facts",
        "policy_bundle",
        "registry",
        "critic_versions"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "maxLength": 64
        },
        "session_id": {
          "description": "Derived server-side from the authenticated agent-host connection; never supplied by the agent (FR-06, SEC-12).",
          "type": "string",
          "maxLength": 128
        },
        "parent_session_id": {
          "type": "string",
          "maxLength": 128
        },
        "session_root_id": {
          "description": "Root of the session tree; session-scoped limits and monitor properties apply to the tree (FR-06).",
          "type": "string",
          "maxLength": 128
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "proposed_at": {
          "type": "string",
          "format": "date-time"
        },
        "repair_iteration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "prior_decision_id": {
          "description": "Set on a retry after a failed/timeout/refused receipt (FR-27).",
          "type": "string",
          "format": "uuid"
        },
        "batch": {
          "$ref": "#/$defs/BatchPosition"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "action_class": {
          "$ref": "#/$defs/ActionClassRef"
        },
        "facts": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/Fact"
          }
        },
        "policy_bundle": {
          "$ref": "#/$defs/VersionedArtifact"
        },
        "registry": {
          "$ref": "#/$defs/VersionedArtifact"
        },
        "critic_versions": {
          "description": "Critic id to version, including solver versions (FR-51).",
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 64
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_.-]*$"
          }
        },
        "stripped_proposal_keys": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        }
      }
    },
    "BatchPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "batch_index",
        "batch_size",
        "batch_policy"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "format": "uuid"
        },
        "batch_index": {
          "type": "integer",
          "minimum": 0
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "batch_policy": {
          "type": "string",
          "enum": [
            "independent",
            "all_or_nothing"
          ]
        }
      }
    },
    "Actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "agent_version",
        "principal",
        "delegation_chain",
        "environment"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "maxLength": 128
        },
        "agent_version": {
          "type": "string",
          "maxLength": 64
        },
        "principal": {
          "description": "Pseudonymous identifier of the human principal, resolved by the identity layer (never from the proposal).",
          "$ref": "#/$defs/Principal"
        },
        "delegation_chain": {
          "description": "Extended only by the identity layer on a harness-mediated spawn (FR-06). Each hop is backed by a verifiable delegation credential (SEC-13).",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/DelegationHop"
          }
        },
        "environment": {
          "type": "string",
          "enum": [
            "development",
            "test",
            "staging",
            "production"
          ]
        },
        "model_identity": {
          "description": "Governed model identity, used for monitor certification matching (FR-54) and per-model metrics.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model_id": {
              "type": "string",
              "maxLength": 128
            },
            "model_version": {
              "type": "string",
              "maxLength": 64
            },
            "prompt_family_digest": {
              "$ref": "#/$defs/Digest"
            }
          }
        }
      }
    },
    "DelegationHop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "credential_status"
      ],
      "properties": {
        "principal": {
          "$ref": "#/$defs/Principal"
        },
        "credential_status": {
          "description": "Result of validating this hop's delegation credential (SEC-13). `unverified` hops cannot satisfy an authorization rule.",
          "type": "string",
          "enum": [
            "verified",
            "unverified",
            "expired"
          ]
        },
        "credential_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "ActionClassRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registered",
        "mode",
        "effect_class"
      ],
      "properties": {
        "registered": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "shadow",
            "advisory",
            "enforce",
            "halted"
          ]
        },
        "effect_class": {
          "type": "string",
          "enum": [
            "none",
            "read",
            "write",
            "destructive"
          ]
        },
        "resource_key": {
          "description": "Canonical resource identifier from the resource-key registry (FR-34); leases and mutual-exclusion properties key on it.",
          "type": "string",
          "pattern": "^(?:(?=[^\\n]{1,158}$)[a-z][a-z0-9-]{0,31}:[A-Za-z0-9][A-Za-z0-9.-]{0,63}(?:/[a-z][a-z0-9-]{0,31}:[A-Za-z0-9][A-Za-z0-9.-]{0,63}){0,38})$",
          "maxLength": 158
        },
        "repair_budget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "approvable": {
          "type": "boolean"
        },
        "escalate_on": {
          "description": "Reason codes whose abstention may escalate to REQUIRES_APPROVAL (spec section 5.5). Rejected by the loader on a non-approvable class.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "enum": [
              "SOLVER_UNKNOWN",
              "SOLVER_TIMEOUT",
              "FACT_MISSING",
              "FACT_STALE"
            ]
          }
        },
        "connector_kind": {
          "type": "string",
          "enum": [
            "sync",
            "async"
          ]
        }
      }
    },
    "Fact": {
      "description": "Obtained by the harness from a registered provider (FR-10, FR-14). The only kind of statement policy may read. A stale or missing required fact is passed as a status-only stub with no `value` (FR-11).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "key",
        "source",
        "provider_version",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 64
        },
        "key": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 256
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "value": {
          "description": "Present only when status is `fresh`; conforms to the provider's registered value_schema (FR-14)."
        },
        "source": {
          "type": "string",
          "maxLength": 128
        },
        "asserted_by": {
          "description": "Principal that produced the underlying evidence, where the backing system exposes it. Rules reject evidence asserted by a principal in the delegation chain (SEC-11).",
          "$ref": "#/$defs/Principal"
        },
        "provider_version": {
          "type": "string",
          "maxLength": 64
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "max_age_seconds": {
          "description": "From the action class's required_facts entry; staleness uses min(ttl_seconds, max_age_seconds) (FR-11).",
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "missing",
            "provider_error"
          ]
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "fresh"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "value",
              "fetched_at",
              "ttl_seconds",
              "digest"
            ]
          }
        },
        {
          "description": "Stale, missing and errored facts are passed as status-only stubs so that no rule can read the value (FR-11).",
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "stale",
                  "missing",
                  "provider_error"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ]
    },
    "VersionedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "digest"
      ],
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 64
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    }
  }
}
